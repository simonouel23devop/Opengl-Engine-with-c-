#pragma once

#include <string>
#include <vector>
#include <memory>
#include <iostream>
#include <cmath>
#include <thread>
#include <chrono>

struct Vector3 {
	float x{0}, y{0}, z{0};
	Vector3() = default;
	Vector3(float X, float Y, float Z) : x(X), y(Y), z(Z) {}
};

// --- Implementations (header-only inline) ---

inline void GameObject::update(float /*dt*/) { }
inline void GameObject::onInteract() { active = !active; }

inline void Cube::update(float dt) {
	if (!active) return;
	rotation.y += rotationSpeed * dt;
	if (rotation.y > 360.0f) rotation.y -= 360.0f;
}
inline void Cube::onInteract() {
	active = !active;
	std::cout << name << " is now " << (active ? "active" : "inactive") << "\n";
}

inline void Sphere::update(float dt) {
	if (!active) return;
	rotation.x += rotationSpeed * dt;
	if (rotation.x > 360.0f) rotation.x -= 360.0f;
}
inline void Sphere::onInteract() {
	active = !active;
	std::cout << name << " toggled to " << (active ? "active" : "inactive") << "\n";
}

inline void Player::move(char direction, float dt) {
	float dist = speed * dt;
	switch (direction) {
	case 'w': position.z += dist; break;
	case 's': position.z -= dist; break;
	case 'a': position.x -= dist; break;
	case 'd': position.x += dist; break;
	case 'q': position.y += dist; break;
	case 'e': position.y -= dist; break;
	default: break;
	}
}

inline Engine::Engine() {}
inline Engine::~Engine() { stop(); }

inline void Engine::init() {
	m_player.position = Vector3{0,0,0};
	spawnDefaultScene();
}

inline void Engine::spawnDefaultScene() {
	auto cube = std::make_shared<Cube>("Cube");
	cube->position = Vector3{2.0f, 0.0f, 0.0f};
	cube->rotation = Vector3{0,0,0};

	auto sphere = std::make_shared<Sphere>("Sphere");
	sphere->position = Vector3{-2.0f,0.0f,0.0f};
	sphere->rotation = Vector3{0,0,0};

	m_objects.push_back(cube);
	m_objects.push_back(sphere);
}

inline void Engine::run() {
	m_running = true;
	using clock = std::chrono::steady_clock;
	auto last = clock::now();

	std::cout << "Simple console engine started. Controls: w/a/s/d move, q/e up/down, i to interact, x to exit." << std::endl;

	while (m_running) {
		auto now = clock::now();
		std::chrono::duration<float> delta = now - last;
		last = now;
		float dt = delta.count();

		std::cout << "\nEnter command (w/a/s/d/q/e to move, i to interact, x to quit, p to print state): ";
		std::string input;
		if (!std::getline(std::cin, input)) { m_running = false; break; }

		if (!input.empty()) processInput(input, dt);

		update(dt);
		render();

		std::this_thread::sleep_for(std::chrono::milliseconds(16));
	}

	std::cout << "Engine stopped." << std::endl;
}

inline void Engine::stop() { m_running = false; }

inline void Engine::processInput(const std::string& input, float dt) {
	for (char c : input) {
		if (c == 'x') { stop(); return; }
		if (c == 'p') { render(); continue; }
		if (c == 'i') {
			float best = 1.5f; std::shared_ptr<GameObject> nearest;
			for (auto& obj : m_objects) {
				float dx = obj->position.x - m_player.position.x;
				float dy = obj->position.y - m_player.position.y;
				float dz = obj->position.z - m_player.position.z;
				float dist = std::sqrt(dx*dx + dy*dy + dz*dz);
				if (dist < best) { best = dist; nearest = obj; }
			}
			if (nearest) nearest->onInteract(); else std::cout << "No object in range to interact with." << std::endl;
			continue;
		}
		m_player.move(c, dt);
	}
}

inline void Engine::update(float dt) { for (auto& obj : m_objects) obj->update(dt); }

inline void Engine::render() {
	std::cout << "--- Scene ---\n";
	std::cout << "Player pos: (" << m_player.position.x << ", " << m_player.position.y << ", " << m_player.position.z << ")\n";
	for (auto& obj : m_objects) {
		std::cout << obj->name << " pos:(" << obj->position.x << ", " << obj->position.y << ", " << obj->position.z << ") ";
		std::cout << " rot:(" << obj->rotation.x << "," << obj->rotation.y << "," << obj->rotation.z << ") ";
		std::cout << (obj->active ? "active" : "inactive") << "\n";
	}
}


class GameObject {
public:
	std::string name;
	Vector3 position;
	Vector3 rotation; // Euler angles in degrees
	bool active{true};

	GameObject(const std::string& n) : name(n) {}
	virtual ~GameObject() = default;

	virtual void update(float dt);
	virtual void onInteract();
};

class Cube : public GameObject {
public:
	float rotationSpeed{90.0f}; // degrees/sec
	Cube(const std::string& n = "Cube") : GameObject(n) {}
	void update(float dt) override;
	void onInteract() override;
};

class Sphere : public GameObject {
public:
	float rotationSpeed{60.0f};
	Sphere(const std::string& n = "Sphere") : GameObject(n) {}
	void update(float dt) override;
	void onInteract() override;
};

class Player {
public:
	Vector3 position;
	float speed{3.0f}; // units per second

	Player() = default;
	void move(char direction, float dt);
};

class Engine {
public:
	Engine();
	~Engine();

	void init();
	void run();
	void stop();

private:
	bool m_running{false};
	Player m_player;
	std::vector<std::shared_ptr<GameObject>> m_objects;

	void update(float dt);
	void render();
	void processInput(const std::string& input, float dt);
	void spawnDefaultScene();
};
